# ===== SIMS Wi-Fi Manager configuration =====
# Copy to .env (setup.ps1 does this for you). Never commit .env.

# demo  = simulated data, no hardware needed (all data is labeled SIMULATED)
# live  = poll real Aruba Instant Virtual Controllers via REST API (read-only in Phase 1)
SIMS_MODE=demo

# Database. SQLite for development; PostgreSQL for production, e.g.
# postgresql+psycopg://sims:password@localhost:5432/sims
SIMS_DATABASE_URL=sqlite:///./sims.db

# --- Secrets (setup.ps1 generates these; do not reuse the examples) ---
# 64+ random chars. Signs login tokens.
SIMS_JWT_SECRET=CHANGE_ME
# Fernet key (urlsafe base64, 32 bytes). Encrypts stored AP credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIMS_FERNET_KEY=CHANGE_ME

# --- First administrator (created on first start only if no users exist) ---
SIMS_ADMIN_USERNAME=admin
SIMS_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# --- Sessions ---
SIMS_SESSION_MINUTES=60

# --- Aruba API ---
SIMS_ARUBA_TIMEOUT_SECONDS=10
# Aruba APs / CX switches usually have self-signed certificates. Accept untrusted
# device-management HTTPS certs by default; encrypted HTTPS remains in use but the
# device is NOT authenticated by a trusted TLS certificate. This is only for Aruba
# connections, never external services. Use SSH host-key pinning for REST bootstrap.
# To enforce chain/hostname validation, set true and optionally provide a CA bundle.
SIMS_ARUBA_VERIFY_TLS=false
# Optional: path to a CA bundle / the AP's exported certificate (PEM) to verify against
SIMS_ARUBA_CA_BUNDLE=

# --- Collector ---
SIMS_POLL_INTERVAL_SECONDS=60
SIMS_RETENTION_DAYS=30

# --- Safety: configuration changes (SSIDs, VLANs, AP names) are DISABLED by default ---
# Set to true only when you are ready to write to a real Virtual Controller. Restart SIMS afterwards.
SIMS_ALLOW_CONFIG_CHANGES=false

# --- CORS (dev frontend origin) ---
SIMS_CORS_ORIGINS=http://localhost:5173

# --- Local AI assistant (Ollama) --- OFF by default
# Install Ollama, run `ollama pull <model>`, then set SIMS_OLLAMA_ENABLED=true and restart.
# SIMS_OLLAMA_MODEL can stay empty: an admin picks the model on the Assistant page.
SIMS_OLLAMA_ENABLED=false
SIMS_OLLAMA_URL=http://127.0.0.1:11434
SIMS_OLLAMA_MODEL=
SIMS_OLLAMA_TIMEOUT_SECONDS=180
# Only set true if Ollama runs on another host. Client data is pseudonymized, but it would leave this machine.
SIMS_OLLAMA_ALLOW_REMOTE=false

# Per-AP RF/system telemetry (2 extra read-only commands per AP per poll). Set false to reduce load on the APs.
SIMS_TELEMETRY_ENABLED=true

# Firmware staging and certificate upload: the APs download from THIS computer, so give its LAN address.
# Run with .\run.ps1 -Lan (or --host 0.0.0.0) and allow TCP 8000 (firmware) and UDP 69 (certificate) from the AP network only.
SIMS_PUBLIC_BASE_URL=
# SIMS_DATA_DIR=            # where uploaded firmware images are stored (default: ./data)
# SIMS_MAX_FIRMWARE_MB=400
# SIMS_FIRMWARE_LINK_HOURS=6
# SIMS_TFTP_BIND=0.0.0.0
# SIMS_TFTP_PORT=69
